# FixProof Environment Variables
# Copy to .env and fill in your values

# === Supabase ===
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# === AI Service ===
AI_SERVICE_URL="http://localhost:8000"
DEEPINFRA_API_KEY="your-deepinfra-api-key"
AI_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"
AI_BASE_URL="https://api.deepinfra.com/v1/openai"

# === App ===
NEXT_PUBLIC_MAP_STYLE="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"
